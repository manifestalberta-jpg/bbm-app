generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  name                String?
  password            String?    // hashed password
  emailVerified       DateTime?
  plan                String     @default("FREE")
  topics              String?    // JSON serialized
  homeAirport         String?
  destinations        String?    // JSON serialized
  dietType            String?
  preferences         String?    // JSON serialized
  receiveDailyPDF     Boolean    @default(true)
  
  // Phase 1 adjustments
  city                String?
  favoriteArtists     String?    // JSON serialized (CSV or JSON array)
  favoriteMovies      String?    // JSON serialized (CSV or JSON array)
  experienceSummary   String?    // Paste resume text or summary
  interests           String?    // JSON serialized (CSV or JSON array)
  desiredCareer       String?
  
  // Phase 2: Revenue Features
  stripeCustomerId    String?    @unique
  stripeSubscription  String?    @unique
  referralCode        String?    @unique
  referralCount       Int        @default(0)
  referredBy          String?    // Referral code of who referred them
  
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  newsletters         Newsletter[]
  dailyPlans          DailyPlan[]
  tripPlans           TripPlan[]
  engagements         UserEngagement[]
  recipes             Recipe[]
  referrals           Referral[] @relation("referrer")
  emailOpens          EmailOpen[]
  deliveryOptimizations DeliveryOptimization[]
  analyticsEvents     AnalyticsEvent[]
}

model Referral {
  id                  String     @id @default(cuid())
  referrerUserId      String
  referredEmail       String
  code                String     @unique
  status              String     @default("pending") // pending, completed, expired
  createdAt           DateTime   @default(now())
  expiresAt           DateTime?
  
  referrer            User       @relation("referrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
}

model UserEngagement {
  id                  String     @id @default(cuid())
  userId              String
  topic               String
  action              String     // viewed, clicked, shared, added_to_plan
  timestamp           DateTime   @default(now())
  duration            Int?       // seconds
  
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailOpen {
  id                  String     @id @default(cuid())
  userId              String
  newsletterId        String
  openedAt            DateTime   @default(now())
  deviceType          String?    // mobile, desktop, tablet
  clientType          String?    // Gmail, Outlook, Apple Mail, etc.
  
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeliveryOptimization {
  id                  String     @id @default(cuid())
  userId              String
  topic               String
  bestDeliveryTime    String     // HH:MM format
  openRate            Float      @default(0)
  clickRate           Float      @default(0)
  lastOptimized       DateTime   @default(now())
  
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id                  String     @id @default(cuid())
  userId              String
  eventType           String     // page_view, api_call, checkout, referral_click, etc.
  eventData           String?    // JSON
  timestamp           DateTime   @default(now())
  
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Topic {
  id            String     @id @default(cuid())
  name          String     @unique
  aiSuggested   Boolean    @default(false)
  approved      Boolean    @default(false)
  createdAt     DateTime   @default(now())
}

model Newsletter {
  id            String     @id @default(cuid())
  userId        String
  topics        String?    // JSON serialized (CSV or JSON)
  date          DateTime   @default(now())
  content       String     @default("")
  pdfUrl        String?
  images        String?    // JSON serialized

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyPlan {
  id            String     @id @default(cuid())
  userId        String
  date          DateTime
  items         String     // JSON serialized
  editHistory   String?    // JSON serialized
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TripPlan {
  id            String     @id @default(cuid())
  userId        String
  destinations  String     // JSON serialized (comma-separated or JSON)
  startDate     DateTime
  endDate       DateTime
  itinerary     String     // JSON serialized
  deals         String?    // JSON serialized
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recipe {
  id            String     @id @default(cuid())
  userId        String?
  dietType      String     // e.g., KETO, MEDITERRANEAN, etc.
  title         String
  ingredients   String     // JSON serialized or CSV
  instructions  String     // JSON serialized or CSV
  calorieCount  Int?
  imageUrl      String?
  createdAt     DateTime   @default(now())

  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
}
